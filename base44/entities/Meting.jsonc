{
  "name": "Meting",
  "type": "object",
  "description": "De laatste stand van een huis: wat de meters nu meten. Het programmaatje thuis (brug/) stuurt die elke ~5 seconden naar de functie ontvangMeting, die per huis één rij overschrijft. Geen geschiedenis.",
  "properties": {
    "huis_id": {
      "type": "string",
      "description": "Bij welk huis (Huis.id) deze stand hoort. Leeg = van voor de omgevingen (oktober 2026); die rij leest niemand meer."
    },
    "moment": {
      "type": "string",
      "format": "date-time",
      "description": "Wanneer Base44 deze stand ontving. De klok van Base44, niet die van het apparaatje thuis: die kan scheef staan."
    },
    "net_w": {
      "type": "number",
      "description": "Vermogen bij de meterkast (HomeWizard P1-meter), in watt. Plus = je neemt af van het net, min = je levert terug. Leeg = geen P1-meter gekoppeld."
    },
    "net_zendure_w": {
      "type": "number",
      "description": "Wat de Zendure P1-meter op dezelfde meterkast meet, in watt, zelfde teken als net_w. Om de twee meters te vergelijken, en als reserve (zie net_bron). Leeg = geen Zendure P1-meter."
    },
    "net_bron": {
      "type": "string",
      "description": "Van welke meter net_w komt: 'homewizard' (de HomeWizard P1, gewoon) of 'zendure-p1' (reserve: de HomeWizard P1 antwoordde niet, of er is er geen). Leeg = geen meter op het net, of een oudere versie van het programmaatje."
    },
    "zon_w": {
      "type": "number",
      "description": "Wat alle zonnepanelen samen nu leveren, in watt: de som van zonnen. Leeg = geen panelen gekoppeld."
    },
    "zonnen": {
      "type": "array",
      "description": "Elke plek met panelen apart, bijvoorbeeld het huis en het dierenverblijf. Elk krijgt een eigen rondje op de foto.",
      "items": {
        "type": "object",
        "properties": {
          "sleutel": { "type": "string", "description": "Vaste naam, bijvoorbeeld 'hw-batterij-zon'." },
          "naam": { "type": "string", "description": "Hoe het in de app heet, bijvoorbeeld 'Zon huis'." },
          "vermogen_w": { "type": "number", "description": "Wat deze panelen nu leveren, in watt. Bij een meter op zon én batterij uitgerekend met de Zendure." }
        }
      }
    },
    "batterij_w": {
      "type": "number",
      "description": "Plus = de batterij levert stroom (ontladen), min = de batterij laadt. In watt. Leeg = geen batterij gekoppeld."
    },
    "batterij_procent": {
      "type": "number",
      "description": "Hoe vol de batterij is, 0 tot 100."
    },
    "batterij_info": {
      "type": "object",
      "description": "Meer over de batterij, zoals de Zendure het zelf meldt (programmaatje 0.5.0 en nieuwer): temperatuur, spanning, grenzen, hoe lang nog. Elke keer, net als batterij_w; leeg = geen batterij, of een oudere versie. Alleen wat de Zendure meldt, nooit serienummers.",
      "properties": {
        "temp_c": { "type": "number", "description": "De warmste accu: de hoogste celtemperatuur, in °C." },
        "temp_min_c": { "type": "number", "description": "De koelste accu, in °C (alleen bij twee of meer accu's)." },
        "behuizing_c": { "type": "number", "description": "De temperatuur binnenin de Zendure, in °C." },
        "spanning_v": { "type": "number", "description": "De spanning van de batterij, in volt." },
        "stroom_a": { "type": "number", "description": "De stroom van of naar de accu's, in ampère, zonder teken (de richting staat in batterij_w)." },
        "laadgrens_pct": { "type": "number", "description": "Tot hoe vol hij laadt (ingesteld in de Zendure-app), in procent." },
        "ontlaadgrens_pct": { "type": "number", "description": "Tot hoe leeg hij ontlaadt (ingesteld in de Zendure-app), in procent." },
        "vol_over_min": { "type": "number", "description": "Bij laden: over hoeveel minuten hij ongeveer tot de laadgrens vol is." },
        "leeg_over_min": { "type": "number", "description": "Bij leveren: over hoeveel minuten hij ongeveer tot de ontlaadgrens leeg is." },
        "verwarmt": { "type": "boolean", "description": "Waar als hij zichzelf nu verwarmt (bij kou)." },
        "kalibreert": { "type": "boolean", "description": "Waar als hij nu zijn batterijstand opnieuw afstelt." },
        "wifi_dbm": { "type": "number", "description": "Het wifi-signaal bij de Zendure, in dBm (−60 of hoger is goed)." },
        "pakketten": { "type": "number", "description": "Hoeveel accu's eraan zitten." },
        "inhoud_kwh": { "type": "number", "description": "Wat de accu's samen kunnen bevatten, in kWh (afgeleid van het soort accu)." },
        "gezondheid_pct": { "type": "number", "description": "De gezondheid van de zwakste accu, in procent (niet elke Zendure meldt dit)." },
        "storing": { "type": "boolean", "description": "Waar als de Zendure een storing meldt." },
        "storing_niveau": { "type": "number", "description": "Hoe ernstig die storing is, zoals de Zendure het meldt (faultLevel)." },
        "cel_min_v": { "type": "number", "description": "De laagste celspanning van alle accu's, in volt (programmaatje 1.4.0, minVol)." },
        "cel_max_v": { "type": "number", "description": "De hoogste celspanning van alle accu's, in volt (programmaatje 1.4.0, maxVol)." },
        "invoer_limiet_w": { "type": "number", "description": "Hoeveel hij hooguit uit het stopcontact laadt, ingesteld in de Zendure-app, in watt (programmaatje 1.4.0, inputLimit)." },
        "uitvoer_limiet_w": { "type": "number", "description": "Hoeveel hij hooguit aan het huis levert, ingesteld in de Zendure-app, in watt (programmaatje 1.4.0, outputLimit)." },
        "omvormer_max_w": { "type": "number", "description": "Het hoogste vermogen van de omvormer in de Zendure, in watt (programmaatje 1.4.0, inverseMaxPower)." },
        "geleerd": {
          "type": "object",
          "description": "Wat het programmaatje van deze batterij leerde (programmaatje 1.4.0): hoeveel kWh er echt uit of in gaat per procent laadniveau, met alle verlies erin. Voor de schatting hoe lang nog. Leeg = nog niets geleerd, of een oudere versie.",
          "properties": {
            "kwh_per_pct_leveren": { "type": "number", "description": "kWh die er echt uitkomt per procent dat het laadniveau zakt." },
            "kwh_per_pct_laden": { "type": "number", "description": "kWh die er echt in moet per procent dat het laadniveau stijgt." },
            "metingen": { "type": "number", "description": "Uit hoeveel stukken van minstens 10% het geleerd is." }
          }
        },
        "accus": {
          "type": "array",
          "description": "Per accu (programmaatje 0.7.0 en nieuwer; hooguit 8, sinds 1.4.0 hooguit 18: drie SolarFlow 2400 AC's met elk 6), op volgorde: Accu 1, 2, 3. Geen serienummers. Leeg = een oudere versie.",
          "items": {
            "type": "object",
            "properties": {
              "nr": { "type": "number", "description": "Welke accu: 1, 2, 3, … (de plek waarop de Zendure hem meldt)." },
              "temp_c": { "type": "number", "description": "De hoogste celtemperatuur van deze accu, in °C." },
              "procent": { "type": "number", "description": "Hoe vol deze accu is, 0 tot 100." },
              "cel_min_v": { "type": "number", "description": "De laagste celspanning in deze accu, in volt (programmaatje 1.4.0)." },
              "cel_max_v": { "type": "number", "description": "De hoogste celspanning in deze accu, in volt (programmaatje 1.4.0)." },
              "gezondheid_pct": { "type": "number", "description": "De gezondheid van deze accu, in procent (programmaatje 1.4.0, als hij het meldt)." },
              "cycli": { "type": "number", "description": "Hoeveel laadcycli deze accu had (programmaatje 1.4.0, als hij het meldt)." },
              "verwarmt": { "type": "boolean", "description": "Waar als deze accu zich nu verwarmt (programmaatje 1.4.0)." }
            }
          }
        }
      }
    },
    "omvormer": {
      "type": "object",
      "description": "Wat de omvormer van de zonnepanelen zelf meldt (GoodWe DT-serie, programmaatje 0.6.0 en nieuwer, alleen lezen): stand, storingen, spanningen, temperatuur, opbrengst. Elke keer, net als batterij_info; leeg = geen omvormer gekoppeld, of een oudere versie. Nooit het type of serienummer.",
      "properties": {
        "bij": { "type": "string", "description": "De sleutel van de zonnebron (zonnen[].sleutel) waar deze omvormer bij hoort, bijvoorbeeld 'hw-zon-huis'. Leeg = de eerste zonnebron." },
        "stand": { "type": "string", "description": "normaal (levert), wacht, storing, controle, onbekend, slaapt (geen antwoord 's nachts: uit) of weg (overdag geen antwoord)." },
        "w": { "type": "number", "description": "Wat de omvormer nu aan het huis levert, in watt." },
        "rijen": {
          "type": "array",
          "description": "Per paneelrij (MPPT), op volgorde: rij 1, rij 2, …",
          "items": {
            "type": "object",
            "properties": {
              "v": { "type": "number", "description": "Spanning van de panelen, in volt." },
              "a": { "type": "number", "description": "Stroom van de panelen, in ampère." }
            }
          }
        },
        "fasen": {
          "type": "array",
          "description": "Per fase van het net, op volgorde L1, L2, L3, zoals de omvormer het meet.",
          "items": {
            "type": "object",
            "properties": {
              "v": { "type": "number", "description": "Netspanning (tegen nul), in volt." },
              "a": { "type": "number", "description": "Stroom van de omvormer op deze fase, in ampère." }
            }
          }
        },
        "hz": { "type": "number", "description": "Netfrequentie, in hertz." },
        "temp_c": { "type": "number", "description": "Temperatuur binnenin de omvormer, in °C." },
        "vandaag_kwh": { "type": "number", "description": "Opbrengst vandaag, in kWh (ook als hij slaapt: de laatste van vandaag)." },
        "totaal_kwh": { "type": "number", "description": "Opbrengst sinds de omvormer er hangt, in kWh." },
        "storingen": { "type": "array", "description": "De foutbits die aan staan (0–31); de app zegt wat ze betekenen.", "items": { "type": "number" } },
        "waarschuwing": { "type": "number", "description": "De waarschuwingscode van de omvormer, als die niet 0 is." },
        "beperkt": { "type": "array", "description": "Waarom hij minder levert, als bits (0 = te warm, …); de app zegt wat ze betekenen.", "items": { "type": "number" } },
        "pf": { "type": "number", "description": "De arbeidsfactor (1 is ideaal), alleen als hij levert (programmaatje 1.4.0)." },
        "bus_v": { "type": "number", "description": "De spanning binnenin de omvormer (busspanning), in volt (programmaatje 1.4.0)." },
        "koelplaat_c": { "type": "number", "description": "De temperatuur van de koelplaat, in °C (programmaatje 1.4.0)." },
        "uren": { "type": "number", "description": "Hoeveel uur de omvormer in totaal in bedrijf was (programmaatje 1.4.0)." },
        "isolatie_kohm": { "type": "number", "description": "De isolatieweerstand van de panelen naar aarde, in kΩ (programmaatje 1.4.0, register 30173; de eenheid is nog niet bevestigd)." },
        "lekstroom_ma": { "type": "number", "description": "De lekstroom naar aarde, in mA (programmaatje 1.4.0, register 30210; nog niet bevestigd)." },
        "sturen": {
          "type": "object",
          "description": "Het begrenzen bij een negatieve prijs (programmaatje 1.5.0, brug/omvormerPlan.mjs): de instelling zoals het programmaatje hem kent, de stand en het plan. Alleen de eigenaar ziet dit; een kijker niet.",
          "properties": {
            "aan": { "type": "boolean", "description": "Waar = de eigenaar zette het aan (zoals het programmaatje het hoorde)." },
            "stand": { "type": "string", "description": "onbekend, vrij, begrensd (door het programmaatje) of eigen (een grens die niet van het programmaatje is)." },
            "pct": { "type": "number", "description": "De grens die het programmaatje zette, in procent van het vermogen (0–90)." },
            "sinds": { "type": "string", "format": "date-time", "description": "Sinds wanneer begrensd." },
            "door": { "type": "string", "description": "'programmaatje'." },
            "aanpassingen": { "type": "number", "description": "Hoe vaak de grens in dit blok aan het verbruik is aangepast." },
            "doel_w": { "type": "number", "description": "Waar de grens op mikt: het eigen verbruik plus een marge, in watt." },
            "grens_pct": { "type": "number", "description": "Bij stand eigen: de grens die er staat, in procent." },
            "verbruik_w": { "type": "number", "description": "Het gewone eigen verbruik overdag, in watt (voor 'begrensd tot ~1,2 kW' in het plan)." },
            "blokken": {
              "type": "array",
              "description": "Het plan: de blokken van vandaag en morgen waarin terugleveren geld kost (of de prijs negatief is maar het niet loont).",
              "items": {
                "type": "object",
                "properties": {
                  "van": { "type": "string", "format": "date-time", "description": "Begin." },
                  "tot": { "type": "string", "format": "date-time", "description": "Einde." },
                  "laagste": { "type": "number", "description": "De laagste waarde van een teruggeleverde kWh in het blok, in euro (onder nul = kost geld); bij loont-niet de laagste kale prijs." },
                  "modus": { "type": "string", "description": "'deels' (tot het eigen verbruik), 'uit' (ook afnemen levert geld op) of 'loont-niet'." },
                  "reden": { "type": "string", "description": "Bij loont-niet: 'saldering' (vanaf 2027 wel)." },
                  "niet": { "type": "string", "description": "Waarom dit blok niet (meer): 'dag' (die dag niet), 'nu-aan', 'mislukt' of 'anders' (iemand anders gaf hem vrij)." }
                }
              }
            },
            "nu_aan": { "type": "boolean", "description": "Waar = in het blok van nu koos de eigenaar 'Nu weer aan'." },
            "fout": { "type": "string", "description": "begrenzen, vrijgeven, eigen of rem (de schrijfrem houdt het even tegen)." },
            "fout_sinds": { "type": "string", "format": "date-time", "description": "Sinds wanneer de fout." },
            "vrij_op": { "type": "string", "format": "date-time", "description": "De laatste 'Nu weer aan' die het programmaatje oppakte." },
            "grens_w": { "type": "number", "description": "Bij stand begrensd: wat de omvormer volgens de grens nog mag leveren, in watt (programmaatje 1.6.0)." },
            "controle": {
              "type": "object",
              "description": "De zelfcontrole na een begrenzing (programmaatje 1.6.0): leeg = nog niet nagekeken.",
              "properties": {
                "uitkomst": { "type": "string", "description": "bezig, werkt of werkt-niet (dan stuurt het programmaatje niet meer tot de eigenaar het opnieuw aanzet)." },
                "op": { "type": "string", "format": "date-time", "description": "Wanneer nagekeken." },
                "pct": { "type": "number", "description": "De grens bij het nakijken, in procent." },
                "voor_w": { "type": "number", "description": "Wat de omvormer vlak voor het begrenzen leverde, in watt." },
                "na_w": { "type": "number", "description": "Wat hij begrensd leverde (het midden van de metingen), in watt." },
                "via": { "type": "string", "description": "Bij werkt: 'omvormer' (hij leverde niet meer dan de grens) of 'net' (de teruglevering op de P1 zakte)." },
                "reden": { "type": "string", "description": "Bij werkt-niet: 'geen-effect' of 'te-veel' (veel minder dan bedoeld: de grens telt anders)." }
              }
            },
            "oorspronkelijk": {
              "type": "object",
              "description": "Hoe de omvormer stond voor het programmaatje hem ooit bediende (programmaatje 1.6.0), voor de geschiedenis.",
              "properties": {
                "grens_pct": { "type": "number", "description": "De teruglevergrens (register 40336)." },
                "schakelaar": { "type": "boolean", "description": "Stond de schakelaar van die grens (register 40327) aan." },
                "op": { "type": "string", "format": "date-time", "description": "Wanneer het programmaatje dat las." }
              }
            }
          }
        }
      }
    },
    "meterkast": {
      "type": "object",
      "description": "Wat de P1-meter verder over de meterkast weet (programmaatje 1.4.0): het tarief van nu, de maandpiek en de meters die aan de slimme meter hangen (gas, water, warmte). Elke keer, net als fasen; leeg = geen P1-meter, of een oudere versie. Nooit ids of de wifinaam.",
      "properties": {
        "tarief": { "type": "number", "description": "Het tarief van nu zoals de slimme meter telt: in Nederland 1 = dal, 2 = normaal." },
        "gemiddeld_w": { "type": "number", "description": "Het gemiddelde vermogen van het lopende kwartier, in watt." },
        "maandpiek_w": { "type": "number", "description": "Het hoogste kwartiergemiddelde van deze maand, in watt (vooral in België)." },
        "maandpiek_op": { "type": "string", "format": "date-time", "description": "Wanneer die maandpiek was." },
        "meters": {
          "type": "array",
          "description": "Per meter aan de slimme meter (hooguit 5): gas, water, warmte, warm_water of warmte_in.",
          "items": {
            "type": "object",
            "properties": {
              "soort": { "type": "string", "description": "gas, water, warmte, warm_water of warmte_in." },
              "stand": { "type": "number", "description": "De meterstand." },
              "eenheid": { "type": "string", "description": "m3, GJ, kWh of MWh." },
              "op": { "type": "string", "format": "date-time", "description": "Wanneer de meter deze stand doorgaf (een gasmeter elke 5 minuten tot elk uur)." },
              "vandaag": { "type": "number", "description": "Wat deze meter vandaag telde (sinds de laatste stand van gisteren), in dezelfde eenheid." }
            }
          }
        }
      }
    },
    "apparaten": {
      "type": "array",
      "description": "Apparaten met een eigen meter (HomeWizard Energy Socket of kWh-meter).",
      "items": {
        "type": "object",
        "properties": {
          "sleutel": { "type": "string", "description": "Vaste naam voor dit apparaat, bijvoorbeeld 'hw-3c39e7aabbcc' (het serienummer van de meter)." },
          "naam": { "type": "string", "description": "Hoe het in de app heet, bijvoorbeeld 'Wasmachine'." },
          "soort": { "type": "string", "description": "Voor het plaatje: wasmachine, vaatwasser, koelkast, laadpaal, warmtepomp, boiler, … of stekker." },
          "vermogen_w": { "type": "number", "description": "Wat het nu gebruikt, in watt." }
        }
      }
    },
    "lampen": {
      "type": "array",
      "description": "Lampen en schakelaars zonder meter (Tuya, programmaatje 0.8.0 en nieuwer, hooguit 20): alleen of ze aan zijn. Elke keer, net als apparaten; leeg = geen, of een oudere versie. De app kijkt alleen, schakelt nooit.",
      "items": {
        "type": "object",
        "properties": {
          "sleutel": { "type": "string", "description": "Vaste naam, bijvoorbeeld 'tuya-spots-overstek'." },
          "naam": { "type": "string", "description": "Hoe het in de app heet, bijvoorbeeld 'Spots overstek'." },
          "soort": { "type": "string", "description": "'lamp' of 'schakelaar'." },
          "aan": { "type": "boolean", "description": "Waar als hij aan is; leeg = niet bekend (geen antwoord)." },
          "helderheid": { "type": "number", "description": "Hoe fel, 1 tot 100 procent (alleen bij een lamp die aan is)." },
          "rol": { "type": "string", "description": "'spots': de spotjes in het overstek van het huis (die branden dan op de tekening)." }
        }
      }
    },
    "bron": {
      "type": "string",
      "description": "Welke versie van het programmaatje dit stuurde, bijvoorbeeld 'brug 0.1.0'."
    },
    "prijs": {
      "type": "object",
      "description": "De stroomprijs van dit moment, in euro per kWh, alles erin (btw, energiebelasting, opslag). Het programmaatje haalt hem bij de leverancier (Zonneplan).",
      "properties": {
        "afname_kwh": { "type": "number", "description": "Wat een kWh uit het net nu kost. Kan onder nul zakken." },
        "teruglevering_kwh": { "type": "number", "description": "Wat een kWh terugleveren nu oplevert, met Zonnebonus als die nu geldt. Kan onder nul zakken." },
        "zonnebonus_kwh": { "type": "number", "description": "Het deel van de terugleverprijs dat Zonnebonus is (0 als hij nu niet geldt)." },
        "van": { "type": "string", "format": "date-time", "description": "Begin van het tijdvak van deze prijs." },
        "tot": { "type": "string", "format": "date-time", "description": "Eind van het tijdvak van deze prijs." },
        "bron": { "type": "string", "description": "Waar de prijs vandaan komt, bijvoorbeeld 'Zonneplan'." }
      }
    },
    "vandaag": {
      "type": "object",
      "description": "Wat er vandaag (Nederlandse tijd) door de meterkast ging en wat dat kostte of opleverde, met de prijs van elk moment.",
      "properties": {
        "datum": { "type": "string", "description": "De dag, bijvoorbeeld '2026-10-30'." },
        "afname_kwh": { "type": "number", "description": "Afgenomen van het net." },
        "teruglevering_kwh": { "type": "number", "description": "Teruggeleverd aan het net." },
        "kosten_eur": { "type": "number", "description": "Betaald voor het afnemen." },
        "opbrengst_eur": { "type": "number", "description": "Gekregen voor het terugleveren." },
        "vaste_kosten_eur": {
          "type": "number",
          "description": "Vaste kosten van deze dag: levering en netbeheer min de korting op de energiebelasting (per maand, gedeeld door de dagen van de maand). Min = per saldo geld terug. Leeg = niet ingevuld."
        },
        "compleet": { "type": "boolean", "description": "Onwaar als een deel van de dag geen prijs had; dat deel zit dan niet in de bedragen." }
      }
    },
    "jaar": {
      "type": "object",
      "description": "Wat er dit kalenderjaar is teruggeleverd. De Zonnebonus geldt voor de eerste 7.500 kWh teruglevering per jaar.",
      "properties": {
        "jaar": { "type": "number", "description": "Het jaar, bijvoorbeeld 2026." },
        "teruglevering_kwh": { "type": "number", "description": "Zoveel kWh is dit jaar teruggeleverd (uit de teller van de P1-meter)." },
        "plafond_kwh": { "type": "number", "description": "Het plafond, 7500." }
      }
    },
    "fasen": {
      "type": "array",
      "description": "Per fase van de P1-meter nu. Bij een eenfase-aansluiting één fase.",
      "items": {
        "type": "object",
        "properties": {
          "fase": { "type": "number", "description": "1, 2 of 3 (L1, L2, L3)." },
          "w": { "type": "number", "description": "Vermogen op deze fase in watt; min = terugleveren op deze fase." },
          "a": { "type": "number", "description": "Stroom op deze fase in ampère (zonder teken)." },
          "v": { "type": "number", "description": "Spanning op deze fase in volt." }
        }
      }
    },
    "voorspelling": {
      "type": "object",
      "description": "De stroomprijzen per kwartier van vandaag (vanaf middernacht) en, vanaf ~13:00, morgen, met dezelfde regels als prijs. Elke rij begint bij van en loopt per stap_min minuten aaneengesloten door. Het programmaatje stuurt hem alleen mee als hij verandert.",
      "properties": {
        "van": { "type": "string", "format": "date-time", "description": "Begin van het eerste kwartier." },
        "stap_min": { "type": "number", "description": "Minuten per stap: 15." },
        "afname_kwh": { "type": "array", "items": { "type": "number" }, "description": "Per kwartier: wat een kWh uit het net kost." },
        "teruglevering_kwh": { "type": "array", "items": { "type": "number" }, "description": "Per kwartier: wat een kWh terugleveren oplevert, met Zonnebonus." },
        "zonnebonus_kwh": { "type": "array", "items": { "type": "number" }, "description": "Per kwartier: het deel dat Zonnebonus is." },
        "schatting": { "type": "boolean", "description": "Waar als Zonneplan niet antwoordde en het een schatting via EnergyZero is." },
        "bron": { "type": "string", "description": "Waar de prijzen vandaan komen, bijvoorbeeld 'Zonneplan'." }
      }
    },
    "weer": {
      "type": "object",
      "description": "Het weerbericht per uur van vandaag en morgen (programmaatje 0.9.0, Open-Meteo), voor Advies. Plek i is het uur dat begint op van + i uur. Elke reeks is even lang; een reeks die er niet is, ontbreekt. Het programmaatje stuurt hem als hij verandert (hooguit eens per uur) en eens per kwartier.",
      "properties": {
        "van": { "type": "string", "format": "date-time", "description": "Begin van het eerste uur (23:00 de dag ervoor, Nederlandse tijd)." },
        "stap_min": { "type": "number", "description": "Minuten per stap: 60." },
        "straling_wm2": { "type": "array", "items": { "type": "number" }, "description": "Per uur: de gemiddelde zonnestraling op de grond (W/m²)." },
        "bewolking_pct": { "type": "array", "items": { "type": "number" }, "description": "Per uur: de bewolking aan het eind van dat uur, 0 tot 100." },
        "temp_c": { "type": "array", "items": { "type": "number" }, "description": "Per uur: de temperatuur buiten op 2 m aan het eind van dat uur (°C)." },
        "weercode": { "type": "array", "items": { "type": "number" }, "description": "Per uur (programmaatje 0.10.0): de WMO-weercode aan het eind van dat uur (0 onbewolkt … 99 zwaar onweer met hagel; zie src/lib/weerBeeld.js), voor het tabblad Voorspelling." },
        "neerslag_mm": { "type": "array", "items": { "type": "number" }, "description": "Per uur (0.10.0): de neerslag in dat uur, in mm." },
        "neerslag_kans_pct": { "type": "array", "items": { "type": "number" }, "description": "Per uur (0.10.0): de kans op meer dan 0,1 mm neerslag in dat uur, 0 tot 100." },
        "windstoten_kmh": { "type": "array", "items": { "type": "number" }, "description": "Per uur (0.10.0): de hardste windstoot op 10 m in dat uur, in km/h." },
        "nu": {
          "type": "object",
          "description": "Het weer van nu (Open-Meteo current), voor de tekening van het huis. Wat er niet is, ontbreekt.",
          "properties": {
            "code": { "type": "number", "description": "De WMO-weercode (0 onbewolkt … 99 zwaar onweer met hagel; zie src/lib/weerBeeld.js)." },
            "neerslag_mm": { "type": "number", "description": "Neerslag in mm (het laatste kwartier)." },
            "wind_kmh": { "type": "number", "description": "Wind op 10 m in km/h." },
            "windstoten_kmh": { "type": "number", "description": "Windstoten op 10 m in km/h." },
            "bewolking_pct": { "type": "number", "description": "Bewolking, 0 tot 100." }
          }
        },
        "opgehaald": { "type": "string", "format": "date-time", "description": "Wanneer het programmaatje dit bericht ophaalde. Ouder dan een paar uur: Advies laat het liggen." },
        "bron": { "type": "string", "description": "Waar het weer vandaan komt: 'open-meteo'." }
      }
    },
    "dag": {
      "type": "object",
      "description": "Vandaag per kwartier: het gemiddelde vermogen van zon, huis, batterij en net en hoe vol de batterij was, plus kWh tot nu. Begint elke dag leeg. Het programmaatje stuurt hem elke minuut mee.",
      "properties": {

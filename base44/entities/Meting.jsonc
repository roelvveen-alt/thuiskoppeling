        "week": {
          "type": "array",
          "description": "De daggemiddelden per fase van de laatste 7 dagen (zonder vandaag).",
          "items": {
            "type": "object",
            "properties": {
              "datum": { "type": "string", "description": "De dag." },
              "fasen": {
                "type": "array",

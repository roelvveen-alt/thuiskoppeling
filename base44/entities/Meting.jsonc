        "stap_min": { "type": "number", "description": "Minuten per stap: 15." },
        "sinds": { "type": "string", "format": "date-time", "description": "De eerste meting van vandaag in dit logboek; daarvoor is er niets." },
        "metingen": { "type": "array", "items": { "type": "number" }, "description": "Per kwartier: hoeveel metingen erin zitten. 0 = geen meting (de waarden zijn dan 0)." },

                "properties": {
                  "soort": { "type": "string", "description": "De soort (herkend), zoals bij nu." },
                  "sleutel": { "type": "string", "description": "De sleutel van een apparaat met een eigen meter (zoals 'hw-spa')." },
                  "naam": { "type": "string", "description": "Een eigen naam, of de naam van de meter." },
                  "keer": { "type": "number", "description": "Hoe vaak aan deze week." },
                  "kwh": { "type": "number", "description": "Hoeveel kWh deze week (op 0,1)." },
                  "dagdeel": { "type": "string", "description": "Wanneer meestal: 'nacht', 'ochtend', 'middag', 'avond'." },
                  "dag": { "type": "number", "description": "Op welke dag meestal: 0 = maandag … 6 = zondag." }
                }
              }
            }
          }
        }
      }
    },
    "kennis": {
      "type": "object",
      "description": "Intern, alleen voor de beheerder (actie overzicht; gaat niet met de stand naar de site): wat elk apparaat teruggeeft, hooguit eens per dag per apparaat (programmaatje 1.4.0). Alleen veldnamen, met een getal als dat niets herkenbaars is; nooit serienummers, adressen, wifinamen, sleutels of tokens.",
      "properties": {
        "op": { "type": "string", "format": "date-time", "description": "Wanneer deze lijst binnenkwam (klok van Base44)." },
        "apparaten": {
          "type": "array",
          "description": "Per apparaat, hooguit 12.",
          "items": {
            "type": "object",
            "properties": {
              "sleutel": { "type": "string", "description": "Welk apparaat: de sleutel van de meter, 'zendure' of 'goodwe'." },
              "soort": { "type": "string", "description": "Bijvoorbeeld 'HomeWizard P1-meter (v2)', 'SolarFlow 2400 AC', 'GoodWe GW8K-DT'." },
              "datum": { "type": "string", "description": "Van welke dag de lijst is." },
              "velden": { "type": "array", "items": { "type": "string" }, "description": "Per veld 'naam' of 'naam=getal', bijvoorbeeld 'active_tariff=2' of 'r30140=9850' (een register van de omvormer)." }
            }
          }
        }
      }
    },
    "spanning": {
      "type": "object",
      "description": "De spanningswacht (programmaatje 1.5.0, brug/spanning.mjs, alleen lezen), eens per minuut: de netspanning per fase uit de beste bron, de hoogste van vandaag, hoe vaak het boven 250 V kwam, uitval bij hoge spanning en de lijst voor de netbeheerder. Leeg = een oudere versie.",
      "properties": {
        "datum": { "type": "string", "description": "De dag (Nederlandse datum)." },
        "herkomst": {
          "type": "array",
          "description": "Waar elke spanning vandaan komt. Leeg = deze meterkast geeft geen spanning door.",
          "items": {
            "type": "object",
            "properties": {
              "sleutel": { "type": "string", "description": "L1, L2, L3, of zon (de fase van een eenfase kWh-meter op de zon; welke fase dat is weet het programmaatje niet)." },
              "bron": { "type": "string", "description": "omvormer, p1, meter (een driefase kWh-meter in huis) of zon (een kWh-meter op de zon)." },
              "naam": { "type": "string", "description": "De naam van de meter uit de instellingen thuis." }
            }
          }
        },
        "nu": {
          "type": "array",
          "description": "Nu per sleutel: de laatste spanning en het 10-minutengemiddelde.",
          "items": { "type": "object", "properties": { "sleutel": { "type": "string", "description": "L1, L2, L3 of zon." }, "v": { "type": "number", "description": "Volt." }, "gem10": { "type": "number", "description": "10 minuten gemiddeld, volt." } } }
        },
        "hoogste": {
          "type": "array",
          "description": "De hoogste spanning van vandaag per sleutel.",
          "items": { "type": "object", "properties": { "sleutel": { "type": "string", "description": "L1, L2, L3 of zon." }, "v": { "type": "number", "description": "Volt." }, "op": { "type": "string", "format": "date-time", "description": "Wanneer." } } }
        },
        "verschil": {
          "type": "array",
          "description": "Het grootste verschil vandaag tussen de zonmeter en elke fase van de driefase meter (zon min fase, volt).",
          "items": { "type": "object", "properties": { "sleutel": { "type": "string", "description": "L1, L2 of L3." }, "v": { "type": "number", "description": "Volt." }, "op": { "type": "string", "format": "date-time", "description": "Wanneer." } } }
        },
        "verschil_met": { "type": "string", "description": "Programmaatje 1.6.0, twee driefase meters (bijvoorbeeld zon en spa): de naam van de meter waarmee de zonmeter per fase vergeleken is (L1 zon − L1 die meter, enz.)." },
        "uitval_vandaag": { "type": "number", "description": "Hoe vaak de omvormer vandaag uitviel bij een hoge spanning." },
        "boven_250_vandaag": { "type": "number", "description": "Hoe vaak een fase vandaag boven 250 V kwam." },
        "boven_250_uitgevallen": { "type": "number", "description": "Hoe vaak hij daarbij ook uitviel." },
        "maand": { "type": "string", "description": "De maand ('2026-07')." },
        "uitval_maand": { "type": "number", "description": "Hoe vaak deze maand." },
        "lijst": {
          "type": "array",
          "description": "De laatste 30 keer uitval bij hoge spanning, voor de netbeheerder.",
          "items": {
            "type": "object",
            "properties": {
              "op": { "type": "string", "format": "date-time", "description": "Wanneer." },
              "sleutel": { "type": "string", "description": "L1, L2, L3 of zon." },
              "v": { "type": "number", "description": "De hoogste spanning in de minuten ervoor, volt." },
              "gem": { "type": "number", "description": "Het 10-minutengemiddelde, volt." },
              "omvormer": { "type": "boolean", "description": "Waar = de omvormer meldde zelf een netspanningsfout." }
            }
          }
        }
      }
    },
    "storingen_open": {
      "type": "array",
      "description": "Intern voor ontvangMeting (gaat niet naar de site): welke storingen van dit huis nu openstaan in het logboek (tabel Gebeurtenis), zodat er alleen bij het begin en het einde geschreven wordt, ook na een herstart van de functie. Leeg = niets open.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "De rij in Gebeurtenis." },
          "sleutel": { "type": "string", "description": "Wat er mis is, bijvoorbeeld 'batterij', 'omvormer:13', 'meter:hw-p1' of 'melding:prijzen:…'." },
          "soort": { "type": "string", "description": "batterij, omvormer, meter of melding." },
          "wat": { "type": "string", "description": "In gewone woorden, zoals in Gebeurtenis.wat." },
          "begin": { "type": "string", "format": "date-time", "description": "Wanneer het begon (klok van Base44)." },
          "gezien": { "type": "string", "format": "date-time", "description": "De laatste meting waarin het nog speelde." },
          "weg": { "type": "string", "format": "date-time", "description": "De eerste meting waarin het weg was; na twee minuten weg is het voorbij. Leeg = speelt nog." }
        }
      }
    }
  },
  // Niemand leest of schrijft dit rechtstreeks. Schrijven doet alleen
  // ontvangMeting, lezen de functie huis voor wie lid is van dat huis; beide
  // met de rol van de server (base44/shared/toegang.js).
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}

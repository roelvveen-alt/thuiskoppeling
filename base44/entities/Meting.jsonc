            }
          }
        },
        "zonnen": {
          "type": "array",
          "description": "Per plek met panelen (programmaatje 0.10.0, alleen bij twee of meer plekken, hooguit 6): per kwartier wat die plek gemiddeld leverde, in watt. Zo leert het tabblad Voorspelling per plek. Leeg = één plek (dan is het zon_w), of een oudere versie.",
          "items": {
            "type": "object",
            "properties": {
              "sleutel": { "type": "string", "description": "De sleutel van de zonnebron (zonnen[].sleutel), bijvoorbeeld 'hw-zon-huis'." },
